  "item": [
    {
      "name": "Drafts",
      "item": [
        {
          "name": "1. Create New Draft (Registration)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rohan Suresh Patil\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"rohan.patil@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/drafts",
              "host": ["{{base_url}}"],
              "path": ["drafts"]
            }
          }
        },
        {
          "name": "2. Get Existing Draft (Resume)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/drafts/{{draft_id}}?email=rohan.patil@example.com",
              "host": ["{{base_url}}"],
              "path": ["drafts", "{{draft_id}}"],
              "query": [
                {
                  "key": "email",
                  "value": "rohan.patil@example.com"
                }
              ]
            }
          }
        },
        {
          "name": "3. Save Draft Panel Progress",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"panel\": 2,\n  \"data\": \"{\\\"district\\\": \\\"Satara\\\", \\\"dob\\\": \\\"2004-05-12\\\"}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/drafts/{{draft_id}}/panel",
              "host": ["{{base_url}}"],
              "path": ["drafts", "{{draft_id}}", "panel"]
            }
          }
        }
      ]
    },
