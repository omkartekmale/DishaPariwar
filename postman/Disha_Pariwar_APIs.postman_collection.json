{
  "info": {
    "_postman_id": "disha-pariwar-apis-2026",
    "name": "Disha Pariwar Charitable Trust APIs",
    "description": "RESTful API collection for Disha Pariwar Scholarship & Student Portal (Spring Boot backend)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Applications",
      "item": [
        {
          "name": "Track Application",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/applications/track?referenceNumber=DP-2026-8492&mobile=9876543210",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "applications", "track"],
              "query": [
                { "key": "referenceNumber", "value": "DP-2026-8492" },
                { "key": "mobile", "value": "9876543210" }
              ]
            }
          }
        },
        {
          "name": "Submit Application",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentName\": \"अनिकेत ज्ञानेश्वर पाटील\",\n  \"gender\": \"MALE\",\n  \"dob\": \"2006-05-14\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"aniket.patil@example.com\",\n  \"category\": \"OPEN\",\n  \"district\": \"सातारा\",\n  \"annualIncome\": 65000,\n  \"marks10th\": 88.40,\n  \"marks12th\": 82.60,\n  \"courseName\": \"B.Tech Computer Engineering\",\n  \"collegeName\": \"Government College of Engineering, Karad\",\n  \"totalCollegeFee\": 45000,\n  \"govtScholarshipReceived\": \"NO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/applications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "applications"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Admin Management",
      "item": [
        {
          "name": "Get All Applications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/applications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "applications"]
            }
          }
        },
        {
          "name": "Update Application Status",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"remarks\": \"कागदपत्र पडताळणी पूर्ण. समितीकडून शिष्यवृत्ती मंजूर करण्यात आली.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/applications/DP-2026-8492/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "applications", "DP-2026-8492", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Inquiries & Contact",
      "item": [
        {
