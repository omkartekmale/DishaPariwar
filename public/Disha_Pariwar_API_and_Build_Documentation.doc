<h2>3. Comprehensive API Test Suite &amp; Test Matrix</h2>

<table>
  <thead>
    <tr>
      <th>Test ID</th>
      <th>Endpoint &amp; Method</th>
      <th>Scenario Tested</th>
      <th>Status</th>
      <th>Key Assertion</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td><strong>TC-P01</strong></td>
      <td><code>GET /applications/track</code></td>
      <td>Track with valid Ref ID and Mobile</td>
      <td><span class="badge badge-success">200 OK</span></td>
      <td>Returns exact student record and current status</td>
    </tr>
    <tr>
      <td><strong>TC-P02</strong></td>
      <td><code>GET /applications/track</code></td>
      <td>Track with Ref ID only (omit mobile)</td>
      <td><span class="badge badge-success">200 OK</span></td>
      <td>Returns applicant record matching Ref ID</td>
    </tr>
    <tr>
      <td><strong>TC-P03</strong></td>
      <td><code>POST /applications</code></td>
      <td>Submit eligible candidate (Merit &gt; 80%, Income &lt; 2L)</td>
      <td><span class="badge badge-success">200/201</span></td>
      <td>Generates unique <code>DP-2026-XXXX</code> reference ID</td>
    </tr>
    <tr>
      <td><strong>TC-P04</strong></td>
      <td><code>GET /admin/applications</code></td>
      <td>List all applications for admin dashboard</td>
      <td><span class="badge badge-success">200 OK</span></td>
      <td>Returns array of applicants with correct data keys</td>
    </tr>
    <tr>
      <td><strong>TC-P05</strong></td>
      <td><code>PUT /admin/.../status</code></td>
      <td>Update status to <code>APPROVED</code> with remarks</td>
      <td><span class="badge badge-success">200 OK</span></td>
      <td>Status updated, Marathi and English labels synchronized</td>
    </tr>
    <tr>
      <td><strong>TC-N01</strong></td>
      <td><code>GET /applications/track</code></td>
      <td>Query with non-existent Reference ID</td>
      <td><span class="badge badge-danger">404</span></td>
      <td>Returns <code>success: false</code> and not found message</td>
    </tr>
    <tr>
      <td><strong>TC-N02</strong></td>
      <td><code>GET /applications/track</code></td>
      <td>Valid Ref ID with wrong mobile number</td>
      <td><span class="badge badge-danger">404</span></td>
      <td>Discrepancy blocked, access denied</td>
    </tr>
    <tr>
      <td><strong>TC-N03</strong></td>
      <td><code>POST /applications</code></td>
      <td>Submit application with empty student name</td>
      <td><span class="badge badge-warning">400</span></td>
      <td>Form rejected with validation failure</td>
    </tr>
    <tr>
      <td><strong>TC-N04</strong></td>
      <td><code>POST /applications</code></td>
      <td>Submit invalid 8-digit mobile number</td>
      <td><span class="badge badge-warning">400</span></td>
      <td>Phone format error returned</td>
    </tr>
    <tr>
      <td><strong>TC-N05</strong></td>
      <td><code>PUT /admin/.../status</code></td>
      <td>Update invalid Reference Number</td>
      <td><span class="badge badge-danger">404</span></td>
      <td>Returns <code>message: "Not found"</code></td>
    </tr>
    <tr>
      <td><strong>TC-E01</strong></td>
      <td><code>POST /applications</code></td>
      <td>Boundary: Annual family income exactly ₹2,00,000</td>
      <td><span class="badge badge-success">200/201</span></td>
      <td>Allowed at upper eligibility boundary</td>
    </tr>
    <tr>
      <td><strong>TC-E02</strong></td>
      <td><code>POST /applications</code></td>
      <td>Boundary: 10th marks exactly 80.00%</td>
      <td><span class="badge badge-success">200/201</span></td>
      <td>Allowed at lower merit boundary</td>
    </tr>
    <tr>
      <td><strong>TC-E03</strong></td>
      <td><code>POST /applications</code></td>
      <td>Unicode Devanagari text fidelity</td>
      <td><span class="badge badge-success">200/201</span></td>
      <td>Devanagari conjuncts preserved with zero corruption</td>
    </tr>
    <tr>
      <td><strong>TC-E04</strong></td>
      <td><code>GET /applications/track</code></td>
      <td>Case insensitive lookup (<code>dp-2026-8492</code>)</td>
      <td><span class="badge badge-success">200 OK</span></td>
      <td>Uppercase normalization retrieves record</td>
    </tr>
  </tbody>
</table>

